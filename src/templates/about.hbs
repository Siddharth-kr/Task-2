<!-- Page Header -->
<section class="bg-primary text-white py-5" style="margin-top: 76px;">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <h1 class="display-4 fw-bold">About Our Services</h1>
                <p class="lead">We specialize in creating modern, responsive websites using the latest web technologies</p>
            </div>
        </div>
    </div>
</section>

<!-- Services Section -->
<section class="py-5">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6">
                <h2 class="display-6 fw-bold mb-4">Our Expertise</h2>
                <p class="text-muted mb-4">
                    We are passionate about creating beautiful, functional websites that deliver exceptional user experiences. 
                    Our team specializes in Bootstrap 5 development, ensuring your website is responsive, accessible, and modern.
                </p>
                
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-check-circle-fill text-primary me-3 fs-5"></i>
                    <span>Responsive Web Design</span>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-check-circle-fill text-primary me-3 fs-5"></i>
                    <span>Bootstrap 5 Customization</span>
                </div>
                <div class="d-flex align-items-center mb-3">
                    <i class="bi bi-check-circle-fill text-primary me-3 fs-5"></i>
                    <span>UI/UX Design Principles</span>
                </div>
                <div class="d-flex align-items-center mb-4">
                    <i class="bi bi-check-circle-fill text-primary me-3 fs-5"></i>
                    <span>Performance Optimization</span>
                </div>
                
                <a href="contact.html" class="btn btn-primary btn-lg">Get in Touch</a>
            </div>
            
            <div class="col-lg-6">
                <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" 
                     alt="Our Team" class="img-fluid rounded shadow">
            </div>
        </div>
    </div>
</section>

<!-- Team Section -->
<section class="bg-light py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold">Meet Our Team</h2>
            <p class="lead text-muted">Experienced professionals dedicated to your success</p>
        </div>
        
        <div class="row g-4">
            {{#each team}}
            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <img src="{{this.image}}" class="card-img-top" alt="{{this.name}}" 
                         style="height: 250px; object-fit: cover;">
                    <div class="card-body text-center">
                        <h5 class="card-title">{{this.name}}</h5>
                        <p class="text-muted">{{this.position}}</p>
                        <p class="card-text">{{this.description}}</p>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</section>